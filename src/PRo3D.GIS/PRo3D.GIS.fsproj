<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\..\bin\Release\</OutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <InPublish>False</InPublish>
  </PropertyGroup>
  <!-- No RuntimeIdentifier/SelfContained/PublishSingleFile here, unlike the executables
       (PRo3D.Viewer, PRo3D.Snapshots): this is a library, and the app it is published with
       supplies the RID. Pinning win-x64 broke the Linux and macOS deploys as soon as a
       RID-agnostic library sat between this project and the app (NETSDK1047): the SDK does not
       flow a RID through a library, so this project fell back to its own win-x64 on a runner
       that only restored linux-x64 or osx-* assets. PRo3D.Core, also a library, never had it. -->
  <ItemGroup>
    <Compile Include="ColorMapping.fs" />
    <EmbeddedResource Include="resources/plasma.png" />
    <EmbeddedResource Include="resources/piyg.png" />
    <EmbeddedResource Include="resources/twilight_shifted.png" />
    <EmbeddedResource Include="resources/vanimo.png" />
    <EmbeddedResource Include="resources/viridis.png" />
    <EmbeddedResource Include="resources/magma.png" />
    <EmbeddedResource Include="resources/hot.png" />
    <EmbeddedResource Include="resources/coolwarm.png" />

    <Compile Include="GeoTiff.fs" />
    <Compile Include="Tiff.fs" />
    <Compile Include="InstrumentImage.fs" />
    <Compile Include="Visualization.fs" />
    <Compile Include="MarsTaggedLocations.fs" />
    <Compile Include="OpcShaders.fs" />
    <Compile Include="Shaders.fs" />
    <Compile Include="CelestialBodies.fs" />
    <Compile Include="ImageProjection.fs" />
    <Compile Include="SunAngles.fs" />
    <Compile Include="Rendering.fs" />
    <Compile Include="Markers.fs" />
    <Compile Include="OpcProjectionSg.fs" />
    <Compile Include="InstrumentObservation.fs" />

    <Compile Include="TestViewer.fs" />
    <None Include="paket.references" />
    <Compile Include="ProjectedImageApp.fs" />
    <Compile Include="ProjectedImageListApp.fs" />
    <Compile Include="GisApp.fs" />
    <Compile Include="ProjectedImagesListHelpers.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PRo3D.Base\PRo3D.Base.fsproj" />
    <ProjectReference Include="..\PRo3D.Core\PRo3D.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="resources\" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>