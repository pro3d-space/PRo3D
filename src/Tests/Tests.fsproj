<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>preview</LangVersion> <!-- https://github.com/dotnet/fsharp/issues/17501 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<OutputPath>..\..\bin\Debug\</OutputPath>
		<NoWarn>0686</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<OutputPath>..\..\bin\Release\</OutputPath>
		<NoWarn>0686</NoWarn>
	</PropertyGroup>
  <ItemGroup>
    <None Include="Annotations\annotation_1.ann" />
	<None Include="Annotations\annotation_1_latlon.json" />
	<None Include="Annotations\annotation_1_xyz.json" />
	<None Include="Annotations\annotation_1_xyz_latlon.json" />
    <Compile Include="GeoJsonExportTest.fs" />
    <Compile Include="SpiceTests.fs" />
    <Compile Include="HeraSpiceTests.fs" />
    <Compile Include="QueriesDSL.fs" />
    <None Include="Playground.fsx" />
    <None Include="RemoteApi.rest" />
    <None Include="paket.references" />
    <Compile Include="BaseTests.fs" />
    <Compile Include="Features\TestHelpers.fs" />
    <Compile Include="Features\Section01_StartingPRo3D.fs" />
    <Compile Include="Features\Section02_ViewerActionsNavigation.fs" />
    <Compile Include="Features\Section03_DrawingAnnotations.fs" />
    <Compile Include="Features\Section04_SurfaceProperties.fs" />
    <Compile Include="Features\Section05_AnnotationProperties.fs" />
    <Compile Include="Features\Section06_Scalebars.fs" />
    <Compile Include="Features\Section07_Bookmarks.fs" />
    <Compile Include="Features\Section08_SequencedBookmarks.fs" />
    <Compile Include="Features\Section09_ViewerConfiguration.fs" />
    <Compile Include="Features\Section10_Grouping.fs" />
    <Compile Include="Features\Section12_GisView.fs" />
    <Compile Include="Features\Section13_ContourMultitexturing.fs" />
    <Compile Include="Features\Section14_SurfaceComparison.fs" />
    <Compile Include="Features\Section16_CommandLine.fs" />
    <Compile Include="Features\Section18_KeyboardShortcuts.fs" />
    <Compile Include="Features\Section19_UndoRedoGroupColor.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PRo3D.Base\PRo3D.Base.fsproj" />
    <ProjectReference Include="..\PRo3D.Core\PRo3D.Core.fsproj" />
    <!-- Scene, SceneLoader and ViewerIO live in the viewer: needed by the TC-1 scene lifecycle tests -->
    <ProjectReference Include="..\PRo3D.Viewer\PRo3D.Viewer.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Thoth.Json.Net" Version="12.0.0" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>